RewriteEngine On

# =================================================================
# 1. SUBDOMAIN & PATH REDIRECTS
# =================================================================
# Redirect Inventory Subdomain
RewriteRule ^inventory/?$ https://inventory.wellen.id [R=301,L]

# Redirect Logistik & Logistic to https://logistic.wellen.id
RewriteRule ^logistik/?$ https://logistic.wellen.id [R=301,L]
RewriteRule ^logistic/?$ https://logistic.wellen.id [R=301,L]
RewriteRule ^dashboard/?$ https://logistic.wellen.id [R=301,L]

# Redirect Kawan Lama portals
RewriteRule ^kawanlama/?$ https://web-track-phi-gilt.vercel.app [R=301,L]
RewriteRule ^adminkawanlama/?$ https://web-track-phi-gilt.vercel.app [R=301,L]

# Redirect Mode Cabang
RewriteRule ^cabang/?$ https://web-track-phi-gilt.vercel.app?mode=cabang [R=301,L]

# =================================================================
# 2. BROWSER CACHING & PERFORMANCE (EXPIRES HEADERS)
# =================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Media (1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript (1 Year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fonts (1 Year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # HTML Documents (1 Hour with revalidation for quick updates)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# =================================================================
# 3. CACHE CONTROL HEADERS
# =================================================================
<IfModule mod_headers.c>
    # Static Assets
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Dynamic / HTML Pages
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>
