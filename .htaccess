RewriteEngine On

# =================================================================
# 1. PATH REDIRECTS TO ON-TRACK VERCEL
# =================================================================
# Redirect Logistik & Dashboard
RewriteRule ^logistik/?$ https://on-track-git-main-pos-ec42.vercel.app [R=301,L]
RewriteRule ^logistic/?$ https://on-track-git-main-pos-ec42.vercel.app [R=301,L]
RewriteRule ^dashboard/?$ https://on-track-git-main-pos-ec42.vercel.app [R=301,L]

# Redirect Kawan Lama portals
RewriteRule ^kawanlama/?$ https://on-track-git-main-pos-ec42.vercel.app [R=301,L]
RewriteRule ^adminkawanlama/?$ https://on-track-git-main-pos-ec42.vercel.app [R=301,L]

# Redirect Mode Cabang
RewriteRule ^cabang/?$ https://on-track-git-main-pos-ec42.vercel.app?mode=cabang [R=301,L]

# =================================================================
# 2. NO CACHE HEADERS FOR QUICK DEPLOYMENT UPDATES
# =================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
